{
  "website_info":{
    "website": "jobintree",
    "root_url": "https://www.jobintree.com",
    "request_url": "/emploi/recherche.html?k={query}&l={location}",
    "query_space_replacement": "+"
  },
  "parsers": [
    {
      "role":"extractor",
      "step": "summary",
      "format": "html",
      "actif": true,
      "selectors": {
        "url": "article > div > h3 > a",
        "libelle": "article > div > h3 > a",
        "entreprise": "ul.job-criteria > li:nth-child(3)",
        "ville": "div > ul:nth-child(2) > li:nth-child(2) > span:nth-child(2)",
        "type_contrat": "div > ul:nth-child(2) > li:nth-child(3) > span:nth-child(2)"
      },
      "pagination":"p"
    },
    {
      "role":"extractor",
      "step": "detail",
      "format": "json",
      "actif": true,
      "json_tag": { "type": "application/ld+json" },
      "json_required_keys": [
        "title",
        "description",
        "hiringOrganization",
        "jobLocation"
      ],
      "selectors": {
        "title": "title",
        "company": "hiringOrganization.name",
        "city": "jobLocation.address.addressLocality",
        "postal_code": "jobLocation.address.postalCode",
        "contract_type": "employmentType",
        "description": "description"

        
      }
    },
    {
      "role":"extractor",
      "step": "detail",
      "format": "html",
      "actif": false,
      "selectors": {
        "title": "h1.marg-none",
        "company": "div.boxed.boxed-white.color-grey.float-none.full-width.marg-btm-s > div:nth-child(1) > p",
        "city": "div.boxed.boxed-white.color-grey.float-none.full-width.marg-btm-s > div:nth-child(2) > p",
        "contract_type": "div.boxed.boxed-white.color-grey.float-none.full-width.marg-btm-s > div:nth-child(3) > p",
        "description": "div.boxed.boxed-white.color-grey.float-none.full-width.marg-btm-s > div.description"
      }
    },
    {
      "role":"transformer",
      "step": "detail",
      "format": "embenddings",
      "actif": false,
      "selectors": {}
    },
    {
      "role":"transformer",
      "step": "detail",
      "format": "keyword",
      "actif": true,
      "selectors": {}
    }
  ]
}
