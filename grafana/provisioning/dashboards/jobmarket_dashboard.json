{
    "id": null,
    "title": "Job Market Monitoring",
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "panels": [
        {
            "type": "graph",
            "title": "PostgreSQL - Active Connections",
            "targets": [
                {
                    "expr": "pg_stat_activity_count",
                    "legendFormat": "Active connections",
                    "interval": ""
                }
            ],
            "datasource": "Prometheus",
            "yaxes": [
                {
                    "format": "short",
                    "label": "Connections",
                    "show": true
                },
                {
                    "show": false
                }
            ]
        },
        {
            "type": "graph",
            "title": "cAdvisor - CPU Usage",
            "targets": [
                {
                    "expr": "container_cpu_usage_seconds_total",
                    "legendFormat": "{{ container_label_com_docker_swarm_service_name }}",
                    "interval": ""
                }
            ],
            "datasource": "Prometheus",
            "yaxes": [
                {
                    "format": "percentunit",
                    "label": "CPU Usage",
                    "show": true
                },
                {
                    "show": false
                }
            ]
        }
    ],
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    }
}